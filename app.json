{
  "expo": {
    "name": "Edit Geek",
    "slug": "edit-geek",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "editgeek",
    "newArchEnabled": true,
    "android": {
      "package": "com.editgeek.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Edit Geek needs access to photos you choose to edit.",
          "cameraPermission": "Edit Geek needs camera access to take a photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
